{
    "openapi": "3.0.0",
    "info": {
        "title": "API REST Example",
        "description": "API para gestionar alumnos, grupos y evaluaciones",
        "version": "1.0.0"
    },
    "paths": {
        "/api/alumnos": {
            "get": {
                "tags": [
                    "Alumnos"
                ],
                "summary": "Listar alumnos",
                "operationId": "getAlumnos",
                "responses": {
                    "200": {
                        "description": "Listado de alumnos",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Alumno"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Alumnos"
                ],
                "summary": "Crear alumno",
                "operationId": "createAlumno",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "legajo",
                                    "nombres",
                                    "apellidos",
                                    "email",
                                    "grupo_id"
                                ],
                                "properties": {
                                    "legajo": {
                                        "type": "integer",
                                        "example": 1234
                                    },
                                    "nombres": {
                                        "type": "string",
                                        "example": "Ana"
                                    },
                                    "apellidos": {
                                        "type": "string",
                                        "example": "García"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "ana@correo.com"
                                    },
                                    "grupo_id": {
                                        "type": "integer",
                                        "example": 2
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Alumno creado"
                    },
                    "422": {
                        "description": "Datos inválidos"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/alumnos/{id}": {
            "get": {
                "tags": [
                    "Alumnos"
                ],
                "summary": "Obtener alumno por id",
                "operationId": "getAlumnoById",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Alumno encontrado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Alumno"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Alumno no encontrado"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/alumnos/{id}/evaluaciones": {
            "get": {
                "tags": [
                    "Alumnos"
                ],
                "summary": "Listar evaluaciones del alumno",
                "operationId": "getAlumnoEvaluaciones",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Listado de evaluaciones"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Alumnos"
                ],
                "summary": "Asignar evaluación a un alumno",
                "operationId": "associateAlumnoEvaluacion",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "evaluacion_id",
                                    "nota",
                                    "fecha_evaluacion"
                                ],
                                "properties": {
                                    "evaluacion_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "nota": {
                                        "type": "number",
                                        "example": 8
                                    },
                                    "fecha_evaluacion": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-08-20"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Evaluación asociada correctamente"
                    },
                    "409": {
                        "description": "La relación ya existe"
                    },
                    "422": {
                        "description": "Payload inválido"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Registrar un nuevo usuario",
                "operationId": "register",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Juan Pérez"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "juan@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "secret123",
                                        "minLength": 6
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "secret123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Usuario registrado exitosamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "user": {
                                            "$ref": "#/components/schemas/User"
                                        },
                                        "token": {
                                            "type": "string",
                                            "example": "1|abc123def456ghi789"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Datos inválidos"
                    }
                }
            }
        },
        "/api/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Iniciar sesión",
                "operationId": "login",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "juan@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "secret123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login exitoso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "user": {
                                            "$ref": "#/components/schemas/User"
                                        },
                                        "token": {
                                            "type": "string",
                                            "example": "1|abc123def456ghi789"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Credenciales inválidas",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Credenciales inválidas"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Cerrar sesión",
                "operationId": "logout",
                "responses": {
                    "200": {
                        "description": "Sesión cerrada",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Sesión cerrada"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/grupos/{grupo}/entregas": {
            "post": {
                "tags": [
                    "Entregas"
                ],
                "summary": "Crear entrega sin idempotencia",
                "operationId": "createEntregaSinIdempotencia",
                "parameters": [
                    {
                        "name": "grupo",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "entrega",
                                    "archivo",
                                    "comentario"
                                ],
                                "properties": {
                                    "entrega": {
                                        "required": [
                                            "nombre",
                                            "fecha_entrega"
                                        ],
                                        "properties": {
                                            "nombre": {
                                                "type": "string",
                                                "example": "TP 1"
                                            },
                                            "fecha_entrega": {
                                                "type": "string",
                                                "format": "date",
                                                "example": "2026-08-20"
                                            }
                                        },
                                        "type": "object"
                                    },
                                    "archivo": {
                                        "type": "string",
                                        "example": "archivo.pdf"
                                    },
                                    "comentario": {
                                        "type": "string",
                                        "example": "Entrega del grupo"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Entrega asociada correctamente"
                    },
                    "409": {
                        "description": "Conflicto de datos duplicados"
                    },
                    "422": {
                        "description": "Payload inválido"
                    }
                }
            }
        },
        "/api/grupos/{grupo}/entregas/idempotent": {
            "post": {
                "tags": [
                    "Entregas"
                ],
                "summary": "Crear entrega con idempotencia",
                "operationId": "createEntregaConIdempotencia",
                "parameters": [
                    {
                        "name": "grupo",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "Idempotency-Key",
                        "in": "header",
                        "description": "Clave para evitar reenvíos duplicados",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "entrega",
                                    "archivo",
                                    "comentario"
                                ],
                                "properties": {
                                    "entrega": {
                                        "required": [
                                            "nombre",
                                            "fecha_entrega"
                                        ],
                                        "properties": {
                                            "nombre": {
                                                "type": "string",
                                                "example": "TP 1"
                                            },
                                            "fecha_entrega": {
                                                "type": "string",
                                                "format": "date",
                                                "example": "2026-08-20"
                                            }
                                        },
                                        "type": "object"
                                    },
                                    "archivo": {
                                        "type": "string",
                                        "example": "archivo.pdf"
                                    },
                                    "comentario": {
                                        "type": "string",
                                        "example": "Entrega del grupo"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Entrega creada con idempotencia"
                    },
                    "200": {
                        "description": "Reintento repetido con la misma clave"
                    },
                    "409": {
                        "description": "Conflicto de datos duplicados"
                    },
                    "422": {
                        "description": "Falta Idempotency-Key o payload inválido"
                    }
                }
            }
        },
        "/api/evaluaciones": {
            "get": {
                "tags": [
                    "Evaluaciones"
                ],
                "summary": "Listar evaluaciones",
                "operationId": "getEvaluaciones",
                "responses": {
                    "200": {
                        "description": "Listado de evaluaciones",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Evaluacion"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Evaluaciones"
                ],
                "summary": "Crear evaluacion",
                "operationId": "createEvaluacion",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "nombre",
                                    "nota_minima_aprobacion",
                                    "nota_minima_promocion"
                                ],
                                "properties": {
                                    "nombre": {
                                        "type": "string",
                                        "example": "Parcial 1"
                                    },
                                    "nota_minima_aprobacion": {
                                        "type": "integer",
                                        "example": 4
                                    },
                                    "nota_minima_promocion": {
                                        "type": "integer",
                                        "example": 7
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Evaluacion creada"
                    },
                    "422": {
                        "description": "Datos inválidos"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/evaluaciones/{id}": {
            "get": {
                "tags": [
                    "Evaluaciones"
                ],
                "summary": "Obtener evaluacion por id",
                "operationId": "getEvaluacionById",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Evaluacion encontrada",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Evaluacion"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Evaluacion no encontrada"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Evaluaciones"
                ],
                "summary": "Actualizar evaluacion",
                "operationId": "updateEvaluacion",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "nombre": {
                                        "type": "string",
                                        "example": "Parcial 1"
                                    },
                                    "nota_minima_aprobacion": {
                                        "type": "integer",
                                        "example": 4
                                    },
                                    "nota_minima_promocion": {
                                        "type": "integer",
                                        "example": 7
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Evaluacion actualizada"
                    },
                    "422": {
                        "description": "Datos inválidos"
                    },
                    "404": {
                        "description": "Evaluacion no encontrada"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Evaluaciones"
                ],
                "summary": "Eliminar evaluacion",
                "operationId": "deleteEvaluacion",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Evaluacion eliminada"
                    },
                    "404": {
                        "description": "Evaluacion no encontrada"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/evaluaciones/{id}/alumnos": {
            "get": {
                "tags": [
                    "Evaluaciones"
                ],
                "summary": "Obtener alumnos de una evaluacion",
                "operationId": "getAlumnosByEvaluacion",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Alumnos obtenidos"
                    },
                    "404": {
                        "description": "Evaluacion no encontrada"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "Alumno": {
                "required": [
                    "legajo",
                    "nombres",
                    "apellidos",
                    "email",
                    "grupo_id"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "legajo": {
                        "type": "integer",
                        "example": 1234
                    },
                    "nombres": {
                        "type": "string",
                        "example": "Ana"
                    },
                    "apellidos": {
                        "type": "string",
                        "example": "García"
                    },
                    "email": {
                        "type": "string",
                        "example": "ana@correo.com"
                    },
                    "grupo_id": {
                        "type": "integer",
                        "example": 2
                    }
                },
                "type": "object"
            },
            "User": {
                "required": [
                    "id",
                    "name",
                    "email"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Juan Pérez"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "juan@example.com"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "Evaluacion": {
                "required": [
                    "nombre",
                    "nota_minima_aprobacion",
                    "nota_minima_promocion"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "nombre": {
                        "type": "string",
                        "example": "Parcial 1"
                    },
                    "nota_minima_aprobacion": {
                        "type": "integer",
                        "example": 4
                    },
                    "nota_minima_promocion": {
                        "type": "integer",
                        "example": 7
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "sanctum": {
                "type": "apiKey",
                "description": "Ingrese el token en formato: Bearer <token>",
                "name": "Authorization",
                "in": "header"
            }
        }
    },
    "tags": [
        {
            "name": "Alumnos",
            "description": "Alumnos"
        },
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Entregas",
            "description": "Entregas"
        },
        {
            "name": "Evaluaciones",
            "description": "Evaluaciones"
        }
    ],
    "security": [
        {
            "sanctum": []
        }
    ]
}